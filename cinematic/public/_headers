# Cloudflare Pages HTTP Headers

# HTML - always revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Root HTML document
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https://fonts.gstatic.com;

# Hashed JS/CSS assets — safe to cache forever (Vite adds content hash to filename)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Versioned intro film — safe to cache forever
/vice-city-video-v2.mp4
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: video/mp4
/vice-city-video-v2.webm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: video/webm

# Audio — cache aggressively; filenames change when the track changes
/vice-city-radio.opus
  Cache-Control: public, max-age=31536000, immutable
/vice-city-radio.mp3
  Cache-Control: public, max-age=31536000, immutable

# Fonts and images
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
*.png
  Cache-Control: public, max-age=86400
*.ico
  Cache-Control: public, max-age=86400
*.webmanifest
  Cache-Control: public, max-age=86400
